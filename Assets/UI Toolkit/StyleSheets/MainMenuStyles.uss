:root {
}

.title {
    font-size: 60px;
    color: rgb(185, 24, 24);
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-top: 181px;
}

.startButton {
    font-size: 55px;
    -unity-font-style: bold;
    width: 25%;
    align-self: center;
    align-content: auto;
    margin-top: 25%;
    color: rgb(105, 47, 46);
    border-top-left-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    border-top-right-radius: 40px;
    border-right-color: rgb(215, 63, 36);
    border-bottom-color: rgb(215, 63, 36);
    border-left-color: rgb(215, 63, 36);
    border-top-color: rgb(215, 63, 36);
    border-left-width: 5px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    background-color: rgb(236, 117, 58);
}

.startButton:hover {
    background-color: rgb(215, 63, 36);
    border-left-color: rgb(236, 117, 58);
    border-top-color: rgb(236, 117, 58);
    border-bottom-color: rgb(236, 117, 58);
    border-right-color: rgb(236, 117, 58);
}
